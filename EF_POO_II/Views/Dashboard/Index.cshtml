@{
    ViewData["Title"] = "Resultados ONPE";
}

<style>
    body {
        background: #f5f7fa;
    }

    .header-onpe {
        background: #003b70;
        color: white;
        padding: 18px;
        border-radius: 8px;
    }

    .card-candidato {
        border-left: 6px solid #0056b3;
        border-radius: 8px;
        background: white;
        padding: 15px;
        margin-bottom: 15px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .candidate-image {
        width: 58px;
        height: 58px;
        object-fit: cover;
    }

    .progress {
        height: 20px;
    }

    .progress-bar {
        font-weight: bold;
    }

    .total-box {
        background: #ffffff;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
</style>

<div class="container mt-4">
    <div class="header-onpe text-center mb-4">
        <h2>RESULTADOS OFICIALES</h2>
        <p class="mb-0">Sistema de conteo electoral - modelo ONPE</p>
    </div>

    <div class="text-end mb-3">
        <a asp-controller="Dashboard" asp-action="ExportarPDF" class="btn btn-danger" data-no-loader="true">
            Exportar Reporte
        </a>
    </div>

    <form class="filter-bar" id="dashboardFilter">
        <div class="filter-field">
            <label class="form-label">Filtrar por candidato</label>
            <input id="filtroDashboard" class="form-control" placeholder="Ej: Lista A..." />
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">Buscar</button>
            <button class="btn btn-outline-secondary" type="button" id="limpiarDashboard">Limpiar</button>
        </div>
    </form>

    <div class="total-box mb-4">
        <h4 id="totalVotos"></h4>
        <small id="totalRegistros">Avance del conteo por candidato</small>
    </div>

    <div class="card p-3 shadow mb-4">
        <canvas id="graficoVotos"></canvas>
    </div>

    <div id="resultados"></div>
    <nav class="mt-3">
        <ul class="pagination justify-content-end" id="dashboardPagination"></ul>
    </nav>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let chart;
    let paginaActual = 1;

    async function cargarDatos(page = 1) {
        paginaActual = page;
        const filtro = document.getElementById("filtroDashboard").value;
        const url = `/Dashboard/ObtenerResultados?page=${page}&filtro=${encodeURIComponent(filtro)}`;
        const response = await fetch(url);
        const payload = await response.json();
        const data = payload.items;

        const labels = data.map(x => x.candidato);
        const votos = data.map(x => x.votos);
        const total = payload.totalVotos;

        document.getElementById("totalVotos").innerText =
            "Total de votos contabilizados: " + total;
        document.getElementById("totalRegistros").innerText =
            "Registros encontrados: " + payload.totalRegistros;

        let html = "";

        data.forEach(x => {
            const porcentaje = total > 0 ? ((x.votos / total) * 100).toFixed(2) : "0.00";
            const imagen = x.imagenUrl
                ? `<img src="${x.imagenUrl}" alt="${x.candidato}" class="candidate-image rounded border me-3">`
                : `<div class="candidate-image rounded border bg-light d-flex align-items-center justify-content-center me-3"><span class="text-muted">N/A</span></div>`;

            html += `
                <div class="card-candidato">
                    <div class="d-flex align-items-center">
                        ${imagen}
                        <div class="flex-grow-1">
                            <h5 class="mb-1">${x.candidato}</h5>
                            <div class="d-flex justify-content-between">
                                <span>${x.votos} votos</span>
                                <strong>${porcentaje}%</strong>
                            </div>
                            <div class="progress mt-2">
                                <div class="progress-bar bg-primary" style="width:${porcentaje}%">
                                    ${porcentaje}%
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
        });

        document.getElementById("resultados").innerHTML = html || `<div class="surface-panel text-muted">No hay registros para el filtro ingresado.</div>`;
        pintarPaginacion(payload.page, payload.totalPages);

        if (chart) {
            chart.data.labels = labels;
            chart.data.datasets[0].data = votos;
            chart.update();
        } else {
            const ctx = document.getElementById('graficoVotos').getContext('2d');
            chart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Votos',
                        data: votos,
                        backgroundColor: '#0056b3'
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }
    }

    function pintarPaginacion(page, totalPages) {
        let html = "";
        if (totalPages > 1) {
            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${i === page ? "active" : ""}">
                    <button class="page-link" type="button" onclick="cargarDatos(${i})">${i}</button>
                </li>`;
            }
        }
        document.getElementById("dashboardPagination").innerHTML = html;
    }

    document.getElementById("dashboardFilter").addEventListener("submit", function (e) {
        e.preventDefault();
        cargarDatos(1);
    });

    document.getElementById("limpiarDashboard").addEventListener("click", function () {
        document.getElementById("filtroDashboard").value = "";
        cargarDatos(1);
    });

    setInterval(() => cargarDatos(paginaActual), 5000);
    cargarDatos();
</script>
