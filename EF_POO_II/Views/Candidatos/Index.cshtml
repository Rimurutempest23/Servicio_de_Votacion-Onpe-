@model IEnumerable<EF_POO_II.Models.Candidato>

@{
    ViewData["Title"] = "Candidatos";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Padron electoral</span>
        <h2>Candidatos</h2>
        <p class="text-muted mb-0">Registros encontrados: @ViewBag.TotalRegistros</p>
    </div>
    <a asp-controller="Candidatos" asp-action="Create" class="btn btn-primary">Crear candidato</a>
</div>

<form asp-controller="Candidatos" asp-action="Index" method="get" class="filter-bar">
    <div class="filter-field">
        <label class="form-label">Filtrar por nombre</label>
        <input name="filtro" value="@ViewBag.Filtro" class="form-control" placeholder="Ej: Lista A..." />
    </div>
    <div class="filter-actions">
        <button class="btn btn-primary">Buscar</button>
        <a asp-controller="Candidatos" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Id</th>
            <th>Nombre</th>
            <th>Total votos</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width: 90px;">
                    @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                    {
                        <img src="@item.ImagenUrl" alt="@item.Nombre" class="rounded border" style="width: 56px; height: 56px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                            <span class="text-muted">N/A</span>
                        </div>
                    }
                </td>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.TotalVotos</td>
                <td class="text-end">
                    <a asp-controller="Candidatos" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-controller="Candidatos" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Paginacion de candidatos">
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-controller="Candidatos" asp-action="Index" asp-route-page="@i" asp-route-filtro="@ViewBag.Filtro">@i</a>
                </li>
            }
        </ul>
    </nav>
}
