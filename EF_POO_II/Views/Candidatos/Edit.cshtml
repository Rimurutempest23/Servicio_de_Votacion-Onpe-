@model EF_POO_II.Models.Candidato

@{
    ViewData["Title"] = "Editar Candidato";
}

<h2>Editar Candidato</h2>

<form asp-controller="Candidatos" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImagenUrl" class="form-label">URL de imagen o logo</label>
        <input asp-for="ImagenUrl" class="form-control" placeholder="/img/lista-a.png o https://..." />
        <span asp-validation-for="ImagenUrl" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
    {
        <div class="mb-3">
            <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="rounded border" style="width: 96px; height: 96px; object-fit: cover;" />
        </div>
    }

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-controller="Candidatos" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
