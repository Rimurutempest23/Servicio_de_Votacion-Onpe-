@model List<EF_POO_II.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Administracion</span>
        <h2>Usuarios</h2>
        <p class="text-muted mb-0">Registros encontrados: @ViewBag.TotalRegistros</p>
    </div>
    <a asp-controller="Usuarios" asp-action="Create" class="btn btn-success">Nuevo Usuario</a>
</div>

<form asp-controller="Usuarios" asp-action="Index" method="get" class="filter-bar">
    <div class="filter-field">
        <label class="form-label">Filtrar por usuario o rol</label>
        <input name="filtro" value="@ViewBag.Filtro" class="form-control" placeholder="Ej: admin, operador..." />
    </div>
    <div class="filter-actions">
        <button class="btn btn-primary">Buscar</button>
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Usuario</th>
            <th>Rol</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Username</td>
                <td>@u.Rol.Nombre</td>
                <td class="text-end">
                    <a asp-controller="Usuarios" asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-warning">
                        Editar
                    </a>
                    <a asp-controller="Usuarios" asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Paginacion de usuarios">
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-controller="Usuarios" asp-action="Index" asp-route-page="@i" asp-route-filtro="@ViewBag.Filtro">@i</a>
                </li>
            }
        </ul>
    </nav>
}
