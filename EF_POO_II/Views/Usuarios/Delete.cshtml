@model EF_POO_II.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<h2>Eliminar Usuario</h2>

<div class="alert alert-warning">
    Seguro que desea eliminar este usuario?
</div>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Usuario</dt>
    <dd class="col-sm-10">@Model.Username</dd>

    <dt class="col-sm-2">Rol</dt>
    <dd class="col-sm-10">@Model.Rol.Nombre</dd>
</dl>

<form asp-controller="Usuarios" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
