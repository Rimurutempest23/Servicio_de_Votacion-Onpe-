@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Seguridad</span>
        <h2>Crear Usuario</h2>
    </div>
    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>

<div class="surface-panel">
    <form asp-controller="Usuarios" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Usuario</label>
                <input name="username" class="form-control" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Contrasena</label>
                <input name="password" type="password" class="form-control" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Rol</label>
                <select name="rolId" class="form-control" required>
                    @foreach (var rol in ViewBag.Roles)
                    {
                        <option value="@rol.Id">@rol.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="action-bar">
            <button class="btn btn-primary">Guardar</button>
            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">@ViewBag.Error</div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
