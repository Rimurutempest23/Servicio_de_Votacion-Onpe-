@model EF_POO_II.Models.ErrorPageViewModel

@{
    ViewData["Title"] = Model.Title;
}

<section class="error-shell">
    <div class="error-code">@Model.StatusCode</div>
    <div>
        <span class="eyebrow">Modulo de excepciones</span>
        <h1>@Model.Title</h1>
        <p>@Model.Message</p>
        @if (!string.IsNullOrWhiteSpace(Model.RequestId))
        {
            <small class="text-muted">RequestId: @Model.RequestId</small>
        }
        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Ir al dashboard</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Iniciar sesion</a>
        </div>
    </div>
</section>
