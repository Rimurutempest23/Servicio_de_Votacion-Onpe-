@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Registro de Votos";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0">🗳️ Registro de Votos</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Registrar Nuevo Voto</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Registrar" method="post">
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Candidato:</label>
                            <select name="candidatoId" class="form-select" required>
                                <option value="" disabled selected>Seleccione un candidato...</option>
                                @foreach (var c in Model)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Cantidad:</label>
                            <input type="number" name="cantidad" class="form-control" min="1" placeholder="Ej: 5" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Registrar Votos
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0">📊 Resultados Actuales</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Candidato</th>
                                <th class="text-center">Total de votos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="align-middle">@c.Nombre</td>
                                    <td class="text-center align-middle">
                                        <span class="badge bg-info text-dark fs-6">@c.Total</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>